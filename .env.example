# Public origin used for canonical URLs, Open Graph metadata, sitemap, and robots.
# Keep localhost for local development; only an HTTPS origin is indexable in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, anonymous product analytics. Collection stays disabled unless the
# operator enables it and a visitor explicitly opts in through the banner.
# The current browser integration sends only allow-listed product events, uses
# in-memory PostHog persistence, and disables autocapture and session replay.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Public legal-page configuration. Keep blank until the operator has confirmed
# the entity, contact channel, address, governing law, and effective date.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ENTITY_ADDRESS=
LEGAL_GOVERNING_LAW=
LEGAL_EFFECTIVE_DATE=

# Server-side upstream for the same-origin read-only evidence proxy. Keep the
# worker host private where possible; do not expose worker credentials here.
LIVE_EVIDENCE_API_URL=
# Backward-compatible local fallback. The browser no longer calls this URL
# directly; the Next.js server proxies it through /api/live-evidence.
NEXT_PUBLIC_LIVE_EVIDENCE_API_URL=

# Wallet sign-in. The server verifies a one-time EIP-191/SIWE-style message,
# binds the address to an account and server-controlled role, and stores only
# hashed session tokens. Keep the SQLite path on durable private server storage
# in a single-instance deployment; use a shared database before scaling out.
# Set this to the deployed web origin. When blank, NEXT_PUBLIC_SITE_URL is
# used; forwarded request headers are only a local-development fallback.
AUTH_ORIGIN=
AUTH_CHAIN_ID=11155111
AUTH_DATABASE_PATH=./web/data/auth.sqlite
AUTH_NONCE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=28800
AUTH_OPERATOR_ADDRESSES=
AUTH_SECURE_COOKIE=

# Live USC worker integration. These values belong to the worker deployment,
# not the web application. Leave blank for local UI and policy tests.
SOURCE_CHAIN_RPC_URL=
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
SOURCE_CHAIN_KEY=1
# Optional network workaround for hosts with broken IPv6 routing to CC3.
LOOMCREDIT_FORCE_IPV4=false
# The worker may be configured from the public source deployment manifest.
SOURCE_ESCROW_ADDRESS=
TRADE_EVIDENCE_USC_ADDRESS=
CREDITCOIN_WALLET_PRIVATE_KEY=
SOURCE_DEPLOYMENT_MANIFEST=./docs/deployments/source-deployment.json
CREDITCOIN_DEPLOYMENT_MANIFEST=./docs/deployments/creditcoin-deployment.json
# Optional CC3 scan start for crash-recovery receipt reconciliation. When
# blank, the worker derives the earliest deployment block from the manifest.
CREDITCOIN_START_BLOCK=

# Deployment/seed operators. Keep these separate from the web process and do
# not commit them. The key may be 64 hex characters or the same value with a
# 0x prefix. Deployment manifests are written under docs/deployments/.
SOURCE_OPERATOR_PRIVATE_KEY=
CREDITCOIN_DEPLOYER_PRIVATE_KEY=
# Optional quote signer address. Blank defaults to the deployer; use a separate
# service signer for a stronger key boundary once the live quote path is used.
CREDITCOIN_AGENT_SIGNER_ADDRESS=
# Agent-only quote signer. On the recorded testnet deployment this may match
# the approved operator signer, but use a separate service key before any
# production or serious deployment. Its derived address must equal the
# allowlisted CREDITCOIN_AGENT_SIGNER_ADDRESS; never send this key to the
# browser or model provider.
CREDITCOIN_AGENT_PRIVATE_KEY=
RISK_GUARD_ADDRESS=
CREDITCOIN_CHAIN_ID=102031
QUOTE_NONCE=0
USC_VERIFIER_ADDRESS=
SANDBOX_LIQUIDITY_MINOR=0

# Source-order seed inputs. The deploy:source manifest supplies the token and
# escrow addresses; these values describe one real testnet order only.
SOURCE_SUPPLIER_ADDRESS=
SOURCE_TERMS_COMMITMENT=
SOURCE_BUYER_IDENTITY_COMMITMENT=
SOURCE_SUPPLIER_IDENTITY_COMMITMENT=
SOURCE_ORDER_ID=
SOURCE_ORDER_VALUE_MINOR=10000000000
SOURCE_GUARANTEE_AMOUNT_MINOR=2000000000
SOURCE_DELIVERY_DAYS=40
SOURCE_NONCE=1

# Agent adapter. If absent, the agent returns REFER and never submits a quote.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini

# Optional worker database path.
WORKER_DATABASE_PATH=./worker/data/worker.db

# Read-only status API for the live evidence console. Keep it on the worker
# host; expose it through a separately authenticated/read-only edge in public
# deployments.
EVIDENCE_API_HOST=127.0.0.1
EVIDENCE_API_PORT=8787
EVIDENCE_API_ALLOWED_ORIGIN=

# Source watcher controls. Set WORKER_START_BLOCK to the first block to scan.
WORKER_START_BLOCK=
WORKER_CONFIRMATIONS=2
WORKER_POLL_INTERVAL_MS=15000
