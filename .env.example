# LoomCredit environment template
# Copy to `.env`; never commit `.env` or place secrets in this file.
# Root `.env` is used by scripts, worker, agent, and deployment commands.
# Next.js-only local values may also go in `web/.env.local`.
# Profiles: local UI -> live worker -> Render -> deployment/signing.

# Web / analytics / legal
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Required before public release; keep blank until verified.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ENTITY_ADDRESS=
LEGAL_GOVERNING_LAW=
LEGAL_EFFECTIVE_DATE=

# Web -> worker read-only evidence proxy. Local dev uses port 8787.
LIVE_EVIDENCE_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_LIVE_EVIDENCE_API_URL=

# Wallet sign-in and server sessions
AUTH_ORIGIN=http://localhost:3000
AUTH_CHAIN_ID=11155111
AUTH_DATABASE_PATH=./web/data/auth.sqlite
AUTH_NONCE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=28800
AUTH_OPERATOR_ADDRESSES=
# Blank auto-detects; use false for HTTP localhost and true for HTTPS.
AUTH_SECURE_COOKIE=

# Live USC worker: CREDITCOIN_WALLET_PRIVATE_KEY and WORKER_START_BLOCK are
# required for `worker:watch`. This public Sepolia endpoint is rate-limited;
# use a provider-owned URL for Render.
SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
SOURCE_CHAIN_KEY=1
LOOMCREDIT_FORCE_IPV4=false

# Blank addresses resolve from the public deployment manifests.
SOURCE_ESCROW_ADDRESS=
TRADE_EVIDENCE_USC_ADDRESS=
SOURCE_DEPLOYMENT_MANIFEST=./docs/deployments/source-deployment.json
CREDITCOIN_DEPLOYMENT_MANIFEST=./docs/deployments/creditcoin-deployment.json
CREDITCOIN_START_BLOCK=
WORKER_START_BLOCK=
WORKER_CONFIRMATIONS=2
WORKER_POLL_INTERVAL_MS=15000

# Fresh disposable CC3 worker wallet; never reuse an operator, deployer,
# or agent-signer key. Accepts 64 hex characters with or without `0x`.
CREDITCOIN_WALLET_PRIVATE_KEY=
WORKER_DATABASE_PATH=./worker/data/worker.db

# Read-only worker status API; keep loopback-only on a single host.
EVIDENCE_API_HOST=127.0.0.1
EVIDENCE_API_PORT=8787
EVIDENCE_API_ALLOWED_ORIGIN=

# Deployment and source-order seed keys. Set only for the specific command,
# then remove them. Use separate funded accounts for every role.
SOURCE_OPERATOR_PRIVATE_KEY=
CREDITCOIN_DEPLOYER_PRIVATE_KEY=
USC_VERIFIER_ADDRESS=
SANDBOX_LIQUIDITY_MINOR=0
ALLOW_MANIFEST_OVERWRITE=false

# CC3 contract / quote controls
CREDITCOIN_CHAIN_ID=102031
QUOTE_NONCE=0

# Groq is OpenAI-compatible; this model supports the JSON Schema response
# format required by the quote adapter. Without MODEL_API_KEY the agent returns REFER.
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
MODEL_NAME=openai/gpt-oss-120b

# RiskGuard signing: separate key, matching derived address, and on-chain
# allowlist are required. `--sign` signs locally; it does not submit.
CREDITCOIN_AGENT_SIGNER_ADDRESS=
CREDITCOIN_AGENT_PRIVATE_KEY=
RISK_GUARD_ADDRESS=
AGENT_SIGN_QUOTE=false

# Source-order seed inputs; commitments must come from the operator.
SOURCE_SUPPLIER_ADDRESS=
SOURCE_TERMS_COMMITMENT=
SOURCE_BUYER_IDENTITY_COMMITMENT=
SOURCE_SUPPLIER_IDENTITY_COMMITMENT=
SOURCE_ORDER_ID=
SOURCE_ORDER_VALUE_MINOR=10000000000
SOURCE_GUARANTEE_AMOUNT_MINOR=2000000000
SOURCE_DELIVERY_DAYS=40
SOURCE_NONCE=1

# Render overrides (set in Render, not here):
# NEXT_PUBLIC_SITE_URL=https://<actual-service>.onrender.com
# AUTH_ORIGIN=https://<actual-service>.onrender.com
# WORKER_DATABASE_PATH=/var/data/worker.sqlite
# AUTH_DATABASE_PATH=/var/data/auth.sqlite
# SOURCE_CHAIN_RPC_URL=<private Sepolia RPC URL>
# CREDITCOIN_WALLET_PRIVATE_KEY=<private disposable CC3 worker key>
# Render injects PORT. Use `corepack pnpm start:render` and mount `/var/data`.
# Render's hosted UI/watcher does not need model, deployer, or agent keys.
